# Ruleta UTA — enrutado de la SPA, caché y cabeceras de seguridad.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Archivos ocultos (.git, .env, …) nunca se sirven; .well-known sí (SSL de cPanel).
  RewriteRule "(^|/)\.(?!well-known)" - [F]

  # /totem, /admin y /demo los resuelve la app en el navegador: cualquier ruta
  # que no sea un archivo o carpeta real devuelve index.html.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Los assets llevan hash en el nombre: se pueden cachear indefinidamente.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # index.html nunca se cachea: es quien apunta a los assets con hash.
  <FilesMatch "(index|reset)\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # La demo incrusta /totem en un iframe del mismo sitio; nadie más puede.
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
